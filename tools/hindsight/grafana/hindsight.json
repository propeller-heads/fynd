          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(hindsight_savings_usd_sum{namespace=\"$Namespace\", state=\"back\", chain=~\"$chain\", solver=~\"$solver\", client=~\"$client\"}[$__range]))",
          "datasource": {
