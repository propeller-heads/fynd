[Unit]
Description=Upload finalized Fynd pairs segments to S3
Wants=network-online.target
After=network-online.target fynd-pairs-collector.service

[Service]
Type=oneshot
User=agent
Group=agent
EnvironmentFile=/etc/fynd-pairs-collector.env
ExecStart=/opt/fynd-pairs/run-with-secrets.sh /opt/fynd-pairs/upload-segments.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fynd-pairs
