[Unit]
Description=APEX/Fynd live batching monitor (hindsight)
Documentation=https://github.com/propeller-heads/fynd/blob/mp/feat/apex-live-monitor/docs/analysis/2026-08-base-cow-phase0/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/apex/fynd
EnvironmentFile=/etc/apex-monitor.env
Environment=RUST_LOG=info
ExecStart=/home/agent/apex/fynd/target/release/hindsight monitor \
    --chain base \
    --tycho-url tycho-base-beta.propellerheads.xyz \
    --protocols uniswap_v2,uniswap_v3,uniswap_v4,pancakeswap_v3,aerodrome_v1,native_wrapper \
    --min-tvl 10 \
    --apex-window-blocks 1 \
    --apex-window-blocks 5 \
    --apex-window-blocks 30 \
    --apex-workers 4 \
    --apex-queue-capacity 64 \
    --apex-budget-ms 3000 \
    --metrics-port 9899 \
    --comparisons-dir /home/agent/apex-data \
    --apex-dir /home/agent/apex-data

Restart=always
RestartSec=30

# One of the box's eight cores stays free for the co-tenants. Measured, they need far less than
# that: PostgreSQL is idle and tycho-rewind is a project directory, not a running service — every
# other process on the box totals about 3% of one core. The extra core buys back the throttling
# the 3 s search budget would otherwise add (8.3% of periods were already clipped at 600%).
CPUQuota=700%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=apex-monitor

[Install]
WantedBy=multi-user.target
