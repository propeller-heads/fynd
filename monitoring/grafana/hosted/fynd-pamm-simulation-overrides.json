    {
      "type": "stat",
      "title": "pAMM swaps served with overrides",
      "description": "Share of the pAMM swaps in served quotes whose state carried Titan's simulation overrides, over the selected range. Counted by WorkerPoolRouter::quote only while the feed reads the overrides (not with --disable-pamm-simulation-overrides).",
