        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(increase(propamm_simulation_overrides_legs_total{namespace=\"$namespace\", chain=\"$chain\", container=~\"$container\", outcome=\"attached\"}[$__range])) / sum(increase(propamm_simulation_overrides_legs_total{namespace=\"$namespace\", chain=\"$chain\", container=~\"$container\"}[$__range]))",
