# For README examples. Keep credentials and .env files out of git.

CHAIN_ID=1
FYND_BASE_URL=https://fynd-api.propellerheads.xyz
FYND_API_KEY=
RPC_URL=

# Wallet example seed.
WDK_SEED_PHRASE=

# Ethereum native ETH -> USDC. Amounts are integer token base units.
FROM_TOKEN=0x0000000000000000000000000000000000000000
TO_TOKEN=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
AMOUNT_IN=1000000000000000
# Set your chosen output floor before ACTION=execute (USDC has 6 decimals).
MIN_AMOUNT_OUT=
RECIPIENT=

# Execution fee caps: blank omits the cap; 0 enforces zero.
# Network caps require Ethereum, sufficient allowance and a WDK swap estimate.
MAX_NETWORK_FEE_BPS=
MAX_PROTOCOL_FEE_BPS=

ACTION=quote
# Returned swap hash for ACTION=status.
SWAP_ID=
