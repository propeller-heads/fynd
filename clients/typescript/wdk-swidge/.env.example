# Example configuration only. Do not commit real credentials, seeds or .env files.
# The library does not automatically load these variables; README examples do.

CHAIN_ID=1
FYND_BASE_URL=https://fynd-api.propellerheads.xyz
FYND_API_KEY=
RPC_URL=

# A nonzero address for no-account quotes; not a private key or signing authority.
QUOTE_SENDER=
# README wallet example only. Use your production wallet's established custody flow.
WDK_SEED_PHRASE=

# Ethereum native ETH -> USDC. Amounts are integer token base units.
FROM_TOKEN=0x0000000000000000000000000000000000000000
TO_TOKEN=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
AMOUNT_IN=1000000000000000
# Set your chosen output floor before ACTION=execute (USDC has 6 decimals).
MIN_AMOUNT_OUT=
RECIPIENT=

# Optional estimate caps. Blank = omitted; 0 = an active zero cap.
# Base and incomplete whole-sequence network estimates reject network caps.
MAX_NETWORK_FEE_BPS=
MAX_PROTOCOL_FEE_BPS=

ACTION=quote
# Original swap hash returned by swidge, required for ACTION=status.
SWAP_ID=
